# ComfyUI backend, reachable over the tailscale-mesh network.
COMFY_URL_IMAGE=http://comfy-docker-tailscale-serve-1:8188
COMFY_URL_VIDEO=http://comfy-docker-tailscale-serve-video-1:8188

# MOSS-Image-Base directory on the ComfyUI image backend, not in the Easel container.
MOSS_IMAGE_MODEL_PATH=/app/ComfyUI/models/moss-image/MOSS-Image-Base

# Optional Suno REST server root URL. Blank disables audio model discovery.
# Use a Docker DNS URL and a shared network for local container-to-container traffic.
SUNO_URL=
SUNO_REST_API_TOKEN=
SUNO_TIMEOUT=180

# Optional shared bearer token. Unset/empty = no auth (local testing).
# When set, untrusted callers must send `Authorization: Bearer <token>`.
EASEL_API_KEY=

# Loopback and Headscale/Tailscale clients skip bearer auth (IPv4 and IPv6).
# Comma-separated CIDRs; explicitly blank requires a bearer token from everyone.
EASEL_TRUSTED_CLIENT_CIDRS=127.0.0.0/8,::1/128,100.64.0.0/10,fd7a:115c:a1e0::/48
# Exact socket-peer IPs/CIDRs of reverse proxies that append X-Forwarded-For.
# For a Headscale Serve sidecar, use its Docker IP, not the whole Docker subnet.
EASEL_TRUSTED_PROXY_CIDRS=

# Public reverse proxies must never inherit tailnet/loopback authentication.
# This takes precedence at the socket peer and every trusted forwarded hop.
# Include both addresses advertised by the public proxy's tailnet node.
EASEL_REQUIRE_AUTH_CIDRS=100.64.0.11/32,fd7a:115c:a1e0::b/128

# External origin for bearer-authenticated clients behind a host-rewriting proxy.
# Trusted local/tailnet clients retain their own HTTP origin. No /v1 suffix.
# EASEL_PUBLIC_URL=https://easel.ait4x.org
# Set to 127.0.0.1 to keep the published Docker HTTP port local to this host.
# Do this before adding a Docker host gateway /32 to trusted client CIDRs.
EASEL_BIND_HOST=0.0.0.0

# Per-job wall-clock budget (seconds) before easel returns 504 (job keeps its prompt_id).
COMFY_JOB_TIMEOUT=600

# Max synchronous image jobs in flight per backend. Async admission is bounded
# separately by the ComfyUI queue; accepted jobs do not hold a synchronous slot.
COMFY_MAX_INFLIGHT=1

# Shared video admission budgets. These are workload heuristics, not VRAM guarantees.
# Benchmark the deployed model/workflow/GPU before raising either limit.
EASEL_VIDEO_MAX_PIXELS=2097152
EASEL_VIDEO_MAX_PIXEL_FRAMES=160000000

# Default OpenAI response_format when the caller omits it: b64_json | url
EASEL_DEFAULT_RESPONSE_FORMAT=b64_json

# Global fallback; Qwen's model-specific default is 25 unless `steps` is supplied.
EASEL_DEFAULT_STEPS=25

# Prompt injected for /v1/images/variations.
# Include the separator below to make variations fan out into multiple angles,
# e.g. "front view|||side view|||3/4 view".
EASEL_VARIATION_PROMPT=recreate this image, same composition and style

# Multi-prompt separator. A `prompt` containing this token is split into several
# prompts -> one image per part (SimplePromptBatcher), refs encoded once. Keeps
# the API OpenAI-compatible (no extra fields). Normal newlines are NOT split.
EASEL_PROMPT_SEPARATOR=|||

# Durable async image receipts/output cache; keep across process restarts.
# Docker Compose uses its persistent image-jobs volume at /app/jobs.
# EASEL_JOB_DIR=/path/to/private/easel/jobs

# Legacy COMFY_URL_FLUX is accepted when COMFY_URL_IMAGE is unset/blank.
# Keep URLs distinct for parallel GPUs, or identical to share one backend queue.

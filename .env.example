# ComfyUI Flux.2 backend, reachable over the tailscale-mesh network.
COMFY_URL_FLUX=http://comfy-docker-tailscale-serve-1:8188

# Optional shared bearer token. Unset/empty = no auth (local testing).
# When set, callers must send `Authorization: Bearer <token>`.
EASEL_API_KEY=

# Per-job wall-clock budget (seconds) before easel returns 504 (job keeps its prompt_id).
COMFY_JOB_TIMEOUT=600

# Max concurrent comfy jobs in flight; over this, easel returns 429 + Retry-After.
COMFY_MAX_INFLIGHT=1

# Default OpenAI response_format when the caller omits it: b64_json | url
EASEL_DEFAULT_RESPONSE_FORMAT=b64_json

# Sampling steps for the Flux.2 schedule.
EASEL_DEFAULT_STEPS=8

# Prompt injected for /v1/images/variations (Flux.2 has no prompt-free mode).
# Include the separator below to make variations fan out into multiple angles,
# e.g. "front view|||side view|||3/4 view".
EASEL_VARIATION_PROMPT=recreate this image, same composition and style

# Multi-prompt separator. A `prompt` containing this token is split into several
# prompts -> one image per part (SimplePromptBatcher), refs encoded once. Keeps
# the API OpenAI-compatible (no extra fields). Normal newlines are NOT split.
EASEL_PROMPT_SEPARATOR=|||
